<Bindings>
	<!-- Wuber's place in the game's own Key Bindings list (Options, Key Bindings, "Wuber").
	     The game loads this file from the addon folder by itself: the TOC must not list it (a listed copy registers twice).
	     The heading and the names are the globals BINDING_HEADER_WUBER, BINDING_NAME_WUBER_TOGGLE and
	     BINDING_NAME_CLICK WuberDriveButton:LeftButton (UI/Commands.lua). No search words on the entries: they taint the game's Options search.
	     "Open Wuber" runs the /wuber handler (opens or closes the window; nothing secure).
	     The big button is a CLICK binding on the secure WuberDriveButton, so the key is a real key press on it, as the
	     Set row in Settings, Driving does with SetOverrideBindingClick (Drive/Button.lua). -->
	<Binding name="WUBER_TOGGLE" header="WUBER" category="ADDONS">
		if SlashCmdList and SlashCmdList["WUBER"] then SlashCmdList["WUBER"]("") end
	</Binding>
	<Binding name="CLICK WuberDriveButton:LeftButton" category="ADDONS"/>
</Bindings>
